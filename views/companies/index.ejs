<div class="page-header">
  <div class="page-header__meta">
    <h1 class="page-header__title">기업 관리</h1>
    <div class="page-header__summary">
      총 <strong class="num"><%= companies ? companies.length : 0 %></strong>개 관심 기업 등록됨
    </div>
  </div>
  <div class="page-header__actions">
    <a href="/companies/new" class="btn btn-primary">+ 기업 등록</a>
  </div>
</div>

<form action="/companies" method="GET" class="filter-bar">
  <input
    type="search"
    name="q"
    class="input"
    placeholder="기업명, 산업군, 메모 검색..."
    value="<%= q %>"
  >
  <button type="submit" class="btn">검색</button>
  <% if (q) { %>
    <a href="/companies" class="btn">초기화</a>
  <% } %>
</form>

<section class="card">
  <% if (!companies || companies.length === 0) { %>
    <div class="empty-state">
      <p>등록된 기업이 없습니다.</p>
      <a href="/companies/new" class="btn btn-primary">첫 기업 등록하기</a>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>기업명</th>
            <th>산업군</th>
            <th>웹사이트</th>
            <th>채용 공고 수</th>
            <th>지원 수</th>
            <th>관리</th>
          </tr>
        </thead>
        <tbody>
          <% for (const company of companies) { %>
            <% const av = companyAvatar(company.name); %>
            <tr>
              <td>
                <div class="cell-two-line">
                  <span class="avatar avatar--md <%= av.className %>"><%= av.initial %></span>
                  <div class="cell-two-line__content">
                    <a href="/companies/<%= company.id %>" class="cell-two-line__title">
                      <strong><%= company.name %></strong>
                    </a>
                    <% if (company.memo) { %>
                      <span class="cell-two-line__sub"><%= company.memo %></span>
                    <% } %>
                  </div>
                </div>
              </td>
              <td>
                <% if (company.industry) { %>
                  <span class="badge"><%= company.industry %></span>
                <% } else { %>
                  <span class="text-muted">-</span>
                <% } %>
              </td>
              <td>
                <% if (company.website) { %>
                  <a href="<%= company.website %>" target="_blank" rel="noopener noreferrer" class="text-sm"><%= company.website %></a>
                <% } else { %>
                  <span class="text-muted">-</span>
                <% } %>
              </td>
              <td><span class="badge num"><%= company.job_count %>건</span></td>
              <td><span class="badge badge--result-in_progress num"><%= company.application_count %>건</span></td>
              <td>
                <div class="inline-actions">
                  <a href="/companies/<%= company.id %>" class="btn btn-sm">상세</a>
                  <a href="/companies/<%= company.id %>/edit" class="btn btn-sm">수정</a>
                </div>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
