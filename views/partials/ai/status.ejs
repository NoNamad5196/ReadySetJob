<%
  /*
    Partial: views/partials/ai/status.ejs
    Include location: views/settings/index.ejs or views/settings/ai.ejs
    Example: include('../partials/ai/status', { aiEnabled, aiConfig })
    Required locals:
      - aiEnabled: boolean (defaults to res.locals.aiEnabled)
      - aiConfig: { enabled, models, features } (defaults to res.locals.aiConfig)
  */
%>
<%
  const cfg = typeof aiConfig !== 'undefined' && aiConfig ? aiConfig : { enabled: false, features: [] };
  const isEnabled = typeof aiEnabled !== 'undefined' ? Boolean(aiEnabled) : Boolean(cfg.enabled);
  const features = Array.isArray(cfg.features) ? cfg.features : [];
%>
<section class="card ai-status-card" id="ai-settings-status">
  <div class="card__header">
    <div>
      <div class="inline-actions">
        <h2 class="card__title">AI 기능 상태</h2>
        <% if (isEnabled) { %>
          <span class="badge badge--result-passed">AI 기능: 사용 가능</span>
          <span class="badge ai-badge">OpenAI 사용</span>
        <% } else { %>
          <span class="badge badge--result-failed">AI 기능: 사용 불가</span>
        <% } %>
      </div>
      <p class="text-muted text-sm">
        <% if (isEnabled) { %>
          OpenAI 연동이 활성화되어 자기소개서 첨삭, 면접 질문 생성, 경험 STAR 초안, 채용 공고 분석·탐색 및 주간 브리핑 기능을 사용할 수 있습니다.
        <% } else { %>
          현재 AI 기능이 비활성화되어 있습니다. 기본 지원·공고·자기소개서 관리 기능은 정상적으로 이용할 수 있습니다.
        <% } %>
      </p>
    </div>
  </div>

  <% if (features.length > 0) { %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>AI 기능</th>
            <th>연동 엔진</th>
            <th>상태</th>
          </tr>
        </thead>
        <tbody>
          <% for (const f of features) { %>
            <tr>
              <td><strong><%= f.label %></strong></td>
              <td><span class="badge ai-badge">OpenAI 사용</span></td>
              <td>
                <% if (isEnabled) { %>
                  <span class="badge badge--result-passed">사용 가능</span>
                <% } else { %>
                  <span class="badge badge--result-failed">사용 불가</span>
                <% } %>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
