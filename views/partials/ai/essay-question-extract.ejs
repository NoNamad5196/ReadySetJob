<%
  const isEnabled = typeof aiEnabled !== 'undefined' ? Boolean(aiEnabled) : false;
  const disabledMsg = typeof AI_DISABLED_MESSAGE !== 'undefined'
    ? AI_DISABLED_MESSAGE
    : 'AI 기능을 지금은 사용할 수 없습니다';
  const targetEssayId = typeof essayId !== 'undefined' && essayId ? essayId : '';
  const formAction = targetEssayId ? `/essays/${targetEssayId}/extract-questions` : '/essays/extract-questions';
%>
<section class="card ai-essay-extract-card" data-ai-essay-extract-root data-essay-id="<%= targetEssayId %>">
  <div class="card__header">
    <div>
      <div class="inline-actions">
        <h2 class="card__title">AI 채용 공고 자소서 문항 자동 추출</h2>
        <span class="badge ai-badge">OpenAI</span>
      </div>
      <p class="text-muted text-sm">
        채용 공고 본문이나 모집 요강 텍스트를 붙여넣으면 자기소개서 문항과 글자수 제한을 추출해 문항 입력란에 자동으로 채워 줍니다.
      </p>
    </div>
  </div>

  <form action="<%= formAction %>" method="POST" data-ai-essay-extract-form>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-field">
      <label for="ai-essay-extract-text">채용 공고 본문 / 문항 안내 텍스트 (최대 12,000자)</label>
      <textarea
        id="ai-essay-extract-text"
        name="text"
        class="input"
        rows="4"
        maxlength="12000"
        placeholder="채용 공고의 자기소개서 문항 안내나 모집 요강 본문을 여기에 붙여넣으세요..."
        data-ai-essay-extract-text
        <%= isEnabled ? '' : 'disabled' %>
      ></textarea>
    </div>

    <div class="inline-actions">
      <% if (isEnabled) { %>
        <button type="submit" class="btn btn-sm btn-primary" data-ai-essay-extract-btn>
          AI로 자소서 문항 추출
        </button>
        <span class="text-muted text-sm" data-ai-essay-extract-status></span>
      <% } else { %>
        <button type="button" class="btn btn-sm btn-primary" disabled aria-disabled="true">
          AI로 자소서 문항 추출
        </button>
        <span class="text-muted text-sm" data-ai-essay-extract-disabled><%= disabledMsg %></span>
      <% } %>
    </div>
  </form>

  <div class="ai-alert ai-alert--error ai-hidden" data-ai-essay-extract-error role="alert"></div>
</section>
