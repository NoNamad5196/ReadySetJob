<div class="page-header">
  <div class="page-header__meta">
    <h1 class="page-header__title">지원 현황</h1>
    <div class="page-header__summary">
      총 <strong class="num"><%= applications ? applications.length : 0 %></strong>개 지원 관리 중
    </div>
  </div>
  <div class="page-header__actions">
    <div class="view-toggle" role="group" aria-label="보기 방식 전환">
      <a href="/applications/board" class="segmented-tab segmented-tab--active" aria-current="page">보드</a>
      <span class="view-toggle__sep" aria-hidden="true">|</span>
      <a href="/applications" class="segmented-tab">목록</a>
    </div>
    <a href="/applications/new" class="btn btn-primary">+ 지원 추가</a>
  </div>
</div>

<form action="/applications/board" method="GET" class="filter-bar">
  <input
    type="search"
    name="q"
    class="input"
    placeholder="기업명, 공고명, 직무, 메모 검색..."
    value="<%= filters.q %>"
  >
  <select name="result" class="input" aria-label="전형 결과 필터">
    <option value="">전체 결과</option>
    <% for (const resKey of APPLICATION_RESULTS) { %>
      <option value="<%= resKey %>" <%= filters.result === resKey ? 'selected' : '' %>>
        <%= RESULT_LABELS[resKey] %>
      </option>
    <% } %>
  </select>
  <button type="submit" class="btn">필터 적용</button>
  <a href="/applications/board" class="btn">초기화</a>
</form>

<div id="kanban-toast" class="kanban-toast" role="alert" aria-live="polite" hidden></div>

<div class="kanban-board" id="kanban-board" data-stages="<%= APPLICATION_STAGES.join(',') %>">
  <% for (const stageKey of APPLICATION_STAGES) { %>
    <% const stageCards = (columns && columns[stageKey]) ? columns[stageKey] : []; %>
    <section
      class="kanban-column"
      data-stage="<%= stageKey %>"
      aria-label="<%= BOARD_STAGE_LABELS[stageKey] %> 컬럼"
    >
      <header class="kanban-column__header">
        <div class="kanban-column__title-wrap">
          <span class="stage-dot stage-dot--<%= stageKey %>"></span>
          <h2 class="kanban-column__title"><%= BOARD_STAGE_LABELS[stageKey] %></h2>
        </div>
        <span class="kanban-column__count" data-column-count="<%= stageKey %>"><%= stageCards.length %></span>
      </header>

      <div class="kanban-column__body" data-column-body="<%= stageKey %>">
        <% for (const appItem of stageCards) { %>
          <% const ddayTarget = appItem.next_event_date || appItem.job_deadline; %>
          <% const dday = calculateDday(ddayTarget); %>
          <% const av = companyAvatar(appItem.company_name); %>
          <article
            class="kanban-card"
            draggable="true"
            tabindex="0"
            data-application-id="<%= appItem.id %>"
            data-stage="<%= appItem.stage %>"
            data-board-order="<%= appItem.board_order %>"
            aria-label="<%= appItem.company_name %> - <%= appItem.job_title %>"
          >
            <div class="kanban-card__header">
              <div class="kanban-card__brand">
                <span class="avatar avatar--sm <%= av.className %>"><%= av.initial %></span>
                <div class="kanban-card__brand-text">
                  <span class="kanban-card__company"><%= appItem.company_name %></span>
                  <span class="kanban-card__position"><%= appItem.job_position || appItem.job_title %></span>
                </div>
              </div>
              <% if (appItem.is_favorite) { %>
                <span class="kanban-card__star" title="즐겨찾기">★</span>
              <% } %>
            </div>

            <a href="/applications/<%= appItem.id %>" class="kanban-card__title">
              <%= appItem.job_title %>
            </a>

            <div class="kanban-card__meta">
              <span class="badge">
                <%= EMPLOYMENT_TYPE_LABELS[appItem.employment_type] || appItem.employment_type %>
              </span>
              <span class="badge badge--result-<%= appItem.result %>">
                <%= RESULT_LABELS[appItem.result] || appItem.result %>
              </span>
            </div>

            <div class="kanban-card__stepper">
              <div class="stepper-dots" aria-label="전형 진행 단계">
                <% const currIdx = APPLICATION_STAGES.indexOf(appItem.stage); %>
                <% for (let i = 0; i < APPLICATION_STAGES.length; i++) { %>
                  <span class="stepper-dot <%= i < currIdx ? 'stepper-dot--filled' : (i === currIdx ? 'stepper-dot--current' : '') %>"></span>
                <% } %>
              </div>
            </div>

            <div class="kanban-card__footer">
              <span class="badge badge--dday-<%= dday.state %>">
                <% if (appItem.next_event_title) { %>
                  <%= appItem.next_event_title %> · <%= dday.label %>
                <% } else { %>
                  마감 <%= dday.label %>
                <% } %>
              </span>
              <% if (appItem.applied_at) { %>
                <span>지원 <%= appItem.applied_at %></span>
              <% } %>
            </div>

            <form
              action="/applications/<%= appItem.id %>/stage"
              method="POST"
              class="kanban-card__fallback-form"
            >
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <label class="sr-only" for="stage-select-<%= appItem.id %>">단계 변경</label>
              <select
                id="stage-select-<%= appItem.id %>"
                name="stage"
                class="input kanban-card__stage-select"
              >
                <% for (const st of APPLICATION_STAGES) { %>
                  <option value="<%= st %>" <%= appItem.stage === st ? 'selected' : '' %>>
                    <%= BOARD_STAGE_LABELS[st] %> (<%= STAGE_LABELS[st] %>)
                  </option>
                <% } %>
              </select>
              <button type="submit" class="btn btn-sm">이동</button>
            </form>
          </article>
        <% } %>
      </div>
    </section>
  <% } %>
</div>

<script src="/js/kanban.js"></script>
