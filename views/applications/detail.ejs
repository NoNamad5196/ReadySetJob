<div class="page-header">
  <div>
    <p class="text-muted">
      <a href="/companies/<%= application.company_id %>"><%= application.company_name %></a>
      ·
      <a href="/jobs/<%= application.job_post_id %>"><%= application.job_title %></a>
    </p>
    <h1 class="page-header__title"><%= application.company_name %> — <%= application.job_title %></h1>
  </div>
  <div class="inline-actions">
    <a href="/applications/<%= application.id %>/edit" class="btn btn-primary">지원 내역 수정</a>
    <form
      action="/applications/<%= application.id %>?_method=DELETE"
      method="POST"
      data-confirm="이 지원 내역을 삭제하시겠습니까?"
    >
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="_method" value="DELETE">
      <button type="submit" class="btn btn-danger">삭제</button>
    </form>
  </div>
</div>

<section class="card">
  <h2>현재 전형 상태</h2>
  <p>
    <strong>전형 단계:</strong>
    <span class="badge badge--stage-<%= application.stage %>">
      <%= STAGE_LABELS[application.stage] || application.stage %>
    </span>
  </p>
  <p>
    <strong>결과:</strong>
    <span class="badge badge--result-<%= application.result %>">
      <%= RESULT_LABELS[application.result] || application.result %>
    </span>
  </p>
  <p><strong>직무:</strong> <%= application.job_position || '-' %></p>
  <p><strong>지원일:</strong> <%= application.applied_at || '-' %></p>
  <p><strong>공고 마감일:</strong> <%= application.job_deadline || '상시' %></p>
  <p><strong>메모:</strong> <%= application.memo || '등록된 메모가 없습니다.' %></p>
</section>

<section class="card">
  <div class="page-header">
    <h2>전형 단계 변경 이력 (Timeline)</h2>
  </div>
  <% if (!application.stageLogs || application.stageLogs.length === 0) { %>
    <p class="text-muted">기록된 전형 변경 이력이 없습니다.</p>
  <% } else { %>
    <ul class="timeline">
      <% for (const log of application.stageLogs) { %>
        <li class="timeline__item">
          <div>
            <% if (log.from_stage) { %>
              <span><%= STAGE_LABELS[log.from_stage] || log.from_stage %> (<%= RESULT_LABELS[log.from_result] || log.from_result %>)</span>
              →
            <% } else { %>
              <span>최초 등록:</span>
            <% } %>
            <strong><%= STAGE_LABELS[log.to_stage] || log.to_stage %> (<%= RESULT_LABELS[log.to_result] || log.to_result %>)</strong>
          </div>
          <div class="text-muted"><%= log.changed_at %></div>
        </li>
      <% } %>
    </ul>
  <% } %>
</section>

<section class="card">
  <div class="page-header">
    <h2>연결된 전형 일정 (<%= application.events.length %>건)</h2>
    <a href="/events?application_id=<%= application.id %>" class="btn btn-sm">일정 추가</a>
  </div>
  <% if (application.events.length === 0) { %>
    <p class="text-muted">등록된 관련 일정이 없습니다.</p>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>일정명</th>
            <th>유형</th>
            <th>일시</th>
            <th>메모</th>
          </tr>
        </thead>
        <tbody>
          <% for (const ev of application.events) { %>
            <tr>
              <td><strong><%= ev.title %></strong></td>
              <td><span class="badge"><%= EVENT_TYPE_LABELS[ev.type] || ev.type %></span></td>
              <td><%= ev.starts_at %></td>
              <td><%= ev.memo || '-' %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<section class="card">
  <div class="page-header">
    <h2>예상 면접 질문 (<%= (typeof interviewQuestions !== 'undefined' && interviewQuestions ? interviewQuestions.length : (application.interviewQuestions ? application.interviewQuestions.length : 0)) %>건)</h2>
    <div>
      <% if (typeof aiEnabled !== 'undefined' && aiEnabled) { %>
        <form action="/applications/<%= application.id %>/interview-questions/generate" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-primary btn-sm">AI 질문 생성</button>
        </form>
      <% } else { %>
        <div class="inline-actions">
          <button type="button" class="btn btn-primary btn-sm" disabled aria-disabled="true">AI 질문 생성</button>
          <span class="text-muted">AI 기능이 비활성화되어 있습니다 (GEMINI_API_KEY 미설정)</span>
        </div>
      <% } %>
    </div>
  </div>

  <% if (typeof questionError !== 'undefined' && questionError) { %>
    <div class="flash flash--error" role="status">
      <%= questionError %>
    </div>
  <% } %>

  <form action="/applications/<%= application.id %>/interview-questions" method="POST" class="form-field">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-field">
      <label for="question-input">면접 질문 직접 추가</label>
      <div class="inline-actions">
        <input
          type="text"
          id="question-input"
          name="question"
          class="input"
          placeholder="예상 면접 질문을 입력하세요 (최대 500자)"
          value="<%= typeof manualQuestion !== 'undefined' && manualQuestion ? manualQuestion : '' %>"
          maxlength="500"
          required
        >
        <button type="submit" class="btn btn-sm btn-primary">추가</button>
      </div>
    </div>
  </form>

  <% const qList = (typeof interviewQuestions !== 'undefined' && interviewQuestions) ? interviewQuestions : (application.interviewQuestions || []); %>
  <% if (!qList || qList.length === 0) { %>
    <p class="text-muted">등록된 예상 면접 질문이 없습니다.</p>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>구분</th>
            <th>면접 질문</th>
            <th>등록일시</th>
            <th>관리</th>
          </tr>
        </thead>
        <tbody>
          <% for (const q of qList) { %>
            <tr>
              <td>
                <% if (q.source === 'ai') { %>
                  <span class="badge badge--stage-coding_test">AI 생성</span>
                <% } else { %>
                  <span class="badge">직접 작성</span>
                <% } %>
              </td>
              <td><%= q.question %></td>
              <td class="text-muted"><%= q.created_at %></td>
              <td>
                <form
                  action="/applications/<%= application.id %>/interview-questions/<%= q.id %>?_method=DELETE"
                  method="POST"
                  data-confirm="이 질문을 삭제하시겠습니까?"
                >
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="_method" value="DELETE">
                  <button type="submit" class="btn btn-sm btn-danger">삭제</button>
                </form>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
