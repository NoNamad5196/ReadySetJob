<%
  const opts = typeof discoverOptions !== 'undefined' && discoverOptions ? discoverOptions : {
    PURPOSES: [],
    FIELD_GROUPS: [],
    DEGREES: [],
    REGIONS: [],
    SCHEDULES: [],
    MAX_FIELDS_COUNT: 3,
    MAX_KEYWORD_LENGTH: 40,
  };
  const f = typeof form !== 'undefined' && form ? form : {
    purpose: 'new_grad',
    purposes: ['new_grad'],
    employment_type: ['new_grad'],
    fields: [],
    region: '서울',
    degree: '',
    schedule: '',
    keyword: '',
  };
  const selectedPurposes = Array.isArray(f.purposes) && f.purposes.length
    ? f.purposes
    : (f.purpose ? [f.purpose] : ['new_grad']);
  const selectedEmploymentTypes = Array.isArray(f.employment_type) && f.employment_type.length
    ? f.employment_type
    : selectedPurposes;
  const selectedFields = Array.isArray(f.fields) ? f.fields : [];
  const list = Array.isArray(results) ? results : null;
  const sources = Array.isArray(citations) ? citations : [];
%>
<div class="page-header">
  <div class="page-header__meta">
    <h1 class="page-header__title">AI 공고 찾기</h1>
    <div class="page-header__summary">
      취업·인턴부터 아르바이트, 대학원 입학 모집까지 버튼만 골라 OpenAI 웹 검색으로 실제 공고를 찾아보세요. 결과는 자동 저장되지 않습니다.
    </div>
  </div>
  <div class="page-header__actions">
    <a href="/jobs" class="btn">채용 공고 목록</a>
  </div>
</div>

<section class="card ai-discover" data-ai-discover-root>
  <div class="card__header">
    <div class="inline-actions">
      <h2 class="card__title">맞춤 탐색 조건</h2>
      <span class="badge ai-badge">OpenAI 웹 검색</span>
    </div>
  </div>

  <% if (!aiEnabled) { %>
    <div class="ai-alert ai-alert--warning" role="status"><%= typeof AI_DISABLED_MESSAGE !== 'undefined' ? AI_DISABLED_MESSAGE : 'AI 기능을 지금은 사용할 수 없습니다' %></div>
  <% } %>

  <form action="/jobs/discover" method="POST" class="ai-discover-form" data-ai-discover-form>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <fieldset class="ai-step" data-discover-step="purpose">
      <legend class="ai-step__legend">
        <span class="ai-step__num num">1</span>
        <span class="ai-step__title">무엇을 찾나요?</span>
        <span class="ai-step__hint" data-discover-purpose-hint>1개 이상 선택 (필수, 복수 선택 가능)</span>
      </legend>
      <div class="ai-chip-row" role="group" aria-label="무엇을 찾나요?">
        <% for (const p of opts.PURPOSES) { %>
          <label class="ai-chip">
            <input
              type="checkbox"
              name="purpose"
              value="<%= p.value %>"
              class="ai-chip__input"
              data-discover-purpose
              data-discover-employment-type
              <%= selectedPurposes.includes(p.value) ? 'checked' : '' %>
            >
            <span class="ai-chip__label"><%= p.label %></span>
          </label>
        <% } %>
      </div>
      <input type="hidden" value="<%= selectedEmploymentTypes.join(',') %>" data-discover-employment-input>
    </fieldset>

    <fieldset class="ai-step" data-discover-step="fields">
      <legend class="ai-step__legend">
        <span class="ai-step__num num">2</span>
        <span class="ai-step__title">분야</span>
        <span class="ai-step__hint" data-discover-fields-hint>1~<%= opts.MAX_FIELDS_COUNT %>개 선택 (필수)</span>
      </legend>

      <% for (const group of opts.FIELD_GROUPS) { %>
        <div
          class="ai-field-group"
          data-field-group="<%= group.key %>"
          data-field-purposes="<%= group.purposes.join(',') %>"
        >
          <div class="ai-field-group__heading"><%= group.heading %></div>
          <div class="ai-chip-row">
            <% for (const fieldName of group.options) { %>
              <label class="ai-chip">
                <input
                  type="checkbox"
                  name="fields"
                  value="<%= fieldName %>"
                  class="ai-chip__input"
                  data-discover-field
                  data-field-group-input="<%= group.key %>"
                  <%= selectedFields.includes(fieldName) ? 'checked' : '' %>
                >
                <span class="ai-chip__label"><%= fieldName %></span>
              </label>
            <% } %>
          </div>
        </div>
      <% } %>

      <div class="ai-substep" data-purpose-only="grad_school">
        <div class="ai-substep__header">
          <span class="ai-substep__title">학위</span>
          <span class="ai-step__hint">대학원 과정 선택 (선택)</span>
        </div>
        <div class="ai-chip-row" role="radiogroup" aria-label="학위">
          <% for (const deg of opts.DEGREES) { %>
            <label class="ai-chip">
              <input
                type="radio"
                name="degree"
                value="<%= deg %>"
                class="ai-chip__input"
                data-discover-degree
                <%= f.degree === deg ? 'checked' : '' %>
              >
              <span class="ai-chip__label"><%= deg %></span>
            </label>
          <% } %>
        </div>
      </div>
    </fieldset>

    <fieldset class="ai-step" data-discover-step="region">
      <legend class="ai-step__legend">
        <span class="ai-step__num num">3</span>
        <span class="ai-step__title">지역</span>
        <span class="ai-step__hint">1개 선택 (필수)</span>
      </legend>
      <div class="ai-chip-row" role="radiogroup" aria-label="지역">
        <% for (const reg of opts.REGIONS) { %>
          <label class="ai-chip">
            <input
              type="radio"
              name="region"
              value="<%= reg %>"
              class="ai-chip__input"
              data-discover-region
              required
              <%= f.region === reg ? 'checked' : '' %>
            >
            <span class="ai-chip__label"><%= reg %></span>
          </label>
        <% } %>
      </div>
    </fieldset>

    <fieldset class="ai-step" data-discover-step="schedule" data-purpose-only="parttime">
      <legend class="ai-step__legend">
        <span class="ai-step__num num">4</span>
        <span class="ai-step__title">근무 형태</span>
        <span class="ai-step__hint">아르바이트 선택 조건 (선택)</span>
      </legend>
      <div class="ai-chip-row" role="radiogroup" aria-label="근무 형태">
        <% for (const sch of opts.SCHEDULES) { %>
          <label class="ai-chip">
            <input
              type="radio"
              name="schedule"
              value="<%= sch %>"
              class="ai-chip__input"
              data-discover-schedule
              <%= f.schedule === sch ? 'checked' : '' %>
            >
            <span class="ai-chip__label"><%= sch %></span>
          </label>
        <% } %>
      </div>
    </fieldset>

    <div class="ai-keyword-row">
      <label for="discover-keyword" class="ai-keyword-row__label">추가 키워드 (선택)</label>
      <input
        id="discover-keyword"
        name="keyword"
        class="input ai-keyword-row__input"
        maxlength="<%= opts.MAX_KEYWORD_LENGTH %>"
        placeholder="예: 핀테크, React, 장학금, 시급 (최대 40자)"
        value="<%= f.keyword %>"
        data-discover-keyword
      >
    </div>

    <div class="inline-actions ai-discover-submit-bar">
      <button type="submit" class="btn btn-primary" data-ai-discover-btn <%= aiEnabled ? '' : 'disabled' %>>AI로 찾기</button>
      <span class="text-muted text-sm" data-ai-discover-status aria-live="polite"></span>
    </div>
  </form>

  <p class="ai-disclaimer">AI 웹 검색 결과는 오래되었거나 부정확할 수 있으니 출처에서 확인 후 등록하세요.</p>

  <div class="ai-alert ai-alert--error <%= error ? '' : 'ai-hidden' %>" role="alert" data-ai-discover-error><%= error || '' %></div>
</section>

<section class="card <%= list ? '' : 'ai-hidden' %>" data-ai-discover-results-card>
  <div class="card__header">
    <div class="inline-actions">
      <h2 class="card__title">검색 결과</h2>
      <span class="badge num" data-ai-discover-count><%= list ? list.length : 0 %></span>
    </div>
  </div>
  <p class="text-muted text-sm <%= list && list.length === 0 ? '' : 'ai-hidden' %>" data-ai-discover-empty>
    출처 URL이 확인된 공고를 찾지 못했습니다. 분야나 지역을 바꿔 다시 검색해 보세요.
  </p>
  <ul class="ai-discover-list" data-ai-discover-list>
    <% if (list) { for (const item of list) { %>
      <%- include('../partials/ai/discover-card', { item }) %>
    <% } } %>
  </ul>
  <div class="ai-discover-sources <%= sources.length ? '' : 'ai-hidden' %>" data-ai-discover-sources>
    <h3 class="ai-feedback-section__title">검색에 인용된 출처</h3>
    <ul class="ai-list" data-ai-discover-sources-list>
      <% for (const s of sources) { %>
        <li><a href="<%= s.url %>" target="_blank" rel="noopener noreferrer"><%= s.title || s.url %></a></li>
      <% } %>
    </ul>
  </div>
</section>

<template data-ai-discover-template>
  <%- include('../partials/ai/discover-card', { item: null }) %>
</template>
