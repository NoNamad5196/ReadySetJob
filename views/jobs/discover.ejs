<%
  const f = typeof form !== 'undefined' && form ? form : { keyword: '', location: '', career: 'any', extra: '' };
  const list = Array.isArray(results) ? results : null;
  const sources = Array.isArray(citations) ? citations : [];
  const careerOptions = [['any', '무관'], ['new_grad', '신입'], ['intern', '인턴'], ['experienced', '경력']];
%>
<div class="page-header">
  <div class="page-header__meta">
    <h1 class="page-header__title">AI 공고 찾기</h1>
    <div class="page-header__summary">
      OpenAI 웹 검색으로 기업 채용 페이지와 주요 채용 플랫폼의 공고를 찾아 드립니다. 결과는 자동 저장되지 않습니다.
    </div>
  </div>
  <div class="page-header__actions">
    <a href="/jobs" class="btn">채용 공고 목록</a>
  </div>
</div>

<section class="card ai-discover" data-ai-discover-root>
  <div class="card__header">
    <div class="inline-actions">
      <h2 class="card__title">검색 조건</h2>
      <span class="badge ai-badge">OpenAI 웹 검색</span>
    </div>
  </div>

  <% if (!aiEnabled) { %>
    <div class="ai-alert ai-alert--warning" role="status"><%= typeof AI_DISABLED_MESSAGE !== 'undefined' ? AI_DISABLED_MESSAGE : 'AI 기능이 비활성화되어 있습니다 (OPENAI_API_KEY 미설정)' %></div>
  <% } %>

  <form action="/jobs/discover" method="POST" class="ai-discover-form" data-ai-discover-form>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="ai-discover-form__grid">
      <div class="form-field">
        <label for="discover-keyword">직무 / 키워드 (필수)</label>
        <input id="discover-keyword" name="keyword" class="input" maxlength="100" required placeholder="예: 프론트엔드, 데이터 분석, 마케팅" value="<%= f.keyword %>">
      </div>
      <div class="form-field">
        <label for="discover-location">지역</label>
        <input id="discover-location" name="location" class="input" maxlength="60" placeholder="예: 서울, 판교, 원격" value="<%= f.location %>">
      </div>
      <div class="form-field">
        <label for="discover-career">경력</label>
        <select id="discover-career" name="career" class="input">
          <% for (const [val, label] of careerOptions) { %>
            <option value="<%= val %>" <%= f.career === val ? 'selected' : '' %>><%= label %></option>
          <% } %>
        </select>
      </div>
      <div class="form-field">
        <label for="discover-extra">추가 조건</label>
        <input id="discover-extra" name="extra" class="input" maxlength="300" placeholder="예: React 사용, 스타트업, 연봉 정보 포함" value="<%= f.extra %>">
      </div>
    </div>
    <div class="inline-actions">
      <button type="submit" class="btn btn-primary" data-ai-discover-btn <%= aiEnabled ? '' : 'disabled' %>>AI로 공고 검색</button>
      <span class="text-muted text-sm" data-ai-discover-status aria-live="polite"></span>
    </div>
  </form>

  <p class="ai-disclaimer">AI 웹 검색 결과는 오래되었거나 부정확할 수 있으니 출처에서 확인 후 등록하세요.</p>

  <div class="ai-alert ai-alert--error <%= error ? '' : 'ai-hidden' %>" role="alert" data-ai-discover-error><%= error || '' %></div>
</section>

<section class="card <%= list ? '' : 'ai-hidden' %>" data-ai-discover-results-card>
  <div class="card__header">
    <div class="inline-actions">
      <h2 class="card__title">검색 결과</h2>
      <span class="badge num" data-ai-discover-count><%= list ? list.length : 0 %></span>
    </div>
  </div>
  <p class="text-muted text-sm <%= list && list.length === 0 ? '' : 'ai-hidden' %>" data-ai-discover-empty>
    출처 URL이 확인된 공고를 찾지 못했습니다. 키워드나 조건을 바꿔 다시 검색해 보세요.
  </p>
  <ul class="ai-discover-list" data-ai-discover-list>
    <% if (list) { for (const item of list) { %>
      <%- include('../partials/ai/discover-card', { item }) %>
    <% } } %>
  </ul>
  <div class="ai-discover-sources <%= sources.length ? '' : 'ai-hidden' %>" data-ai-discover-sources>
    <h3 class="ai-feedback-section__title">검색에 인용된 출처</h3>
    <ul class="ai-list" data-ai-discover-sources-list>
      <% for (const s of sources) { %>
        <li><a href="<%= s.url %>" target="_blank" rel="noopener noreferrer"><%= s.title || s.url %></a></li>
      <% } %>
    </ul>
  </div>
</section>

<template data-ai-discover-template>
  <%- include('../partials/ai/discover-card', { item: null }) %>
</template>
