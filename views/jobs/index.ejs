<div class="page-header">
  <div class="page-header__meta">
    <h1 class="page-header__title">채용 공고</h1>
    <div class="page-header__summary">
      총 <strong class="num"><%= jobs ? jobs.length : 0 %></strong>개 채용 공고 관리 중
    </div>
  </div>
  <div class="page-header__actions">
    <div class="segmented-tabs" role="group" aria-label="공고 보기 전환">
      <a
        href="/jobs"
        class="segmented-tab <%= filters.bookmarked !== '1' ? 'segmented-tab--active' : '' %>"
        <%= filters.bookmarked !== '1' ? 'aria-current="page"' : '' %>
      >전체</a>
      <a
        href="/jobs?bookmarked=1"
        class="segmented-tab <%= filters.bookmarked === '1' ? 'segmented-tab--active' : '' %>"
        <%= filters.bookmarked === '1' ? 'aria-current="page"' : '' %>
      >북마크</a>
    </div>
    <a href="/jobs/new" class="btn btn-primary">+ 채용 공고 등록</a>
  </div>
</div>

<form action="/jobs" method="GET" class="filter-bar">
  <input
    type="search"
    name="q"
    class="input"
    placeholder="기업명, 공고명, 직무 검색..."
    value="<%= filters.q %>"
  >
  <select name="employment_type" class="input" aria-label="채용 형태 필터">
    <option value="">전체 채용 형태</option>
    <% for (const type of EMPLOYMENT_TYPES) { %>
      <option value="<%= type %>" <%= filters.employment_type === type ? 'selected' : '' %>>
        <%= EMPLOYMENT_TYPE_LABELS[type] %>
      </option>
    <% } %>
  </select>
  <select name="bookmarked" class="input" aria-label="북마크 여부 필터">
    <option value="">전체 공고</option>
    <option value="1" <%= filters.bookmarked === '1' ? 'selected' : '' %>>북마크만 보기</option>
  </select>
  <select name="sort" class="input" aria-label="정렬 기준">
    <option value="deadline" <%= filters.sort === 'deadline' ? 'selected' : '' %>>마감일 빠른순</option>
    <option value="recent" <%= filters.sort === 'recent' ? 'selected' : '' %>>최근 등록순</option>
  </select>
  <button type="submit" class="btn">필터 적용</button>
  <a href="/jobs" class="btn">초기화</a>
</form>

<section class="card">
  <% if (!jobs || jobs.length === 0) { %>
    <div class="empty-state">
      <p>조건에 맞는 채용 공고가 없습니다.</p>
      <a href="/jobs/new" class="btn btn-primary">새 채용 공고 등록하기</a>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th class="col-action">북마크</th>
            <th>기업 / 공고 제목</th>
            <th>직무 / 형태</th>
            <th>마감일 (D-Day)</th>
            <th>지원 현황</th>
            <th>관리</th>
          </tr>
        </thead>
        <tbody>
          <% for (const job of jobs) { %>
            <% const av = companyAvatar(job.company_name); %>
            <% const dday = calculateDday(job.deadline); %>
            <tr>
              <td>
                <form action="/jobs/<%= job.id %>/bookmark" method="POST">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="redirect_to" value="/jobs<%= filters.bookmarked === '1' ? '?bookmarked=1' : '' %>">
                  <button
                    type="submit"
                    class="favorite-btn <%= job.is_bookmarked ? 'favorite-btn--active' : '' %>"
                    aria-label="북마크 토글"
                    title="<%= job.is_bookmarked ? '북마크 해제' : '북마크 추가' %>"
                  >
                    <span class="star-icon <%= job.is_bookmarked ? '' : 'star-icon--muted' %>"><%= job.is_bookmarked ? '★' : '☆' %></span>
                    <span><%= job.is_bookmarked ? '관심' : '해제' %></span>
                  </button>
                </form>
              </td>
              <td>
                <div class="cell-two-line">
                  <span class="avatar avatar--sm <%= av.className %>"><%= av.initial %></span>
                  <div class="cell-two-line__content">
                    <a href="/jobs/<%= job.id %>" class="cell-two-line__title">
                      <strong><%= job.title %></strong>
                    </a>
                    <span class="cell-two-line__sub">
                      <a href="/companies/<%= job.company_id %>"><%= job.company_name %></a>
                    </span>
                  </div>
                </div>
              </td>
              <td>
                <div class="inline-actions">
                  <span><%= job.position || '-' %></span>
                  <span class="badge"><%= EMPLOYMENT_TYPE_LABELS[job.employment_type] || job.employment_type %></span>
                </div>
              </td>
              <td>
                <span class="num"><%= job.deadline || '상시' %></span>
                <span class="badge badge--dday-<%= dday.state %>"><%= dday.label %></span>
              </td>
              <td>
                <% if (job.application_id) { %>
                  <a href="/applications/<%= job.application_id %>">
                    <span class="badge badge--stage-<%= job.application_stage %>"><%= STAGE_LABELS[job.application_stage] %></span>
                  </a>
                <% } else { %>
                  <a href="/applications/new?job_post_id=<%= job.id %>" class="btn btn-sm">지원하기</a>
                <% } %>
              </td>
              <td>
                <div class="inline-actions">
                  <a href="/jobs/<%= job.id %>" class="btn btn-sm">상세</a>
                  <a href="/jobs/<%= job.id %>/edit" class="btn btn-sm">수정</a>
                </div>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
