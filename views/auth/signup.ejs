<div class="auth-card">
  <div class="auth-header">
    <a href="/signup" class="auth-brand">
      <svg class="sidebar__brand-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
      <span>ReadySetJob<span class="sidebar__brand-dot">.</span></span>
    </a>
    <h1 class="auth-title">회원가입</h1>
    <p class="auth-desc">새 계정을 생성하고 채용 지원 현황을 체계적으로 관리하세요.</p>
  </div>

  <% if (error) { %>
    <div class="flash flash--error" role="alert"><%= error %></div>
  <% } %>

  <form action="/signup" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-field">
      <label for="name">이름</label>
      <input
        type="text"
        id="name"
        name="name"
        class="input"
        required
        value="<%= (typeof values !== 'undefined' && values && values.name) || '' %>"
      >
    </div>
    <div class="form-field">
      <label for="email">이메일</label>
      <input
        type="email"
        id="email"
        name="email"
        class="input"
        required
        autocomplete="email"
        value="<%= (typeof values !== 'undefined' && values && values.email) || '' %>"
      >
    </div>
    <div class="form-field">
      <label for="password">비밀번호 (8자 이상)</label>
      <input
        type="password"
        id="password"
        name="password"
        class="input"
        minlength="8"
        required
        autocomplete="new-password"
      >
    </div>
    <div class="auth-actions">
      <button type="submit" class="btn btn-primary btn-lg">가입하기</button>
      <a href="/login" class="btn btn-lg">이미 계정이 있으신가요? 로그인</a>
    </div>
  </form>
</div>
