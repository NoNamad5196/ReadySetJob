<link rel="stylesheet" href="/css/spec-discover.css">
<%
  const f = form;
  const list = Array.isArray(results) ? results : null;
  const selectedFields = Array.isArray(f.fields) ? f.fields : [];
%>
<div class="page-header">
  <div class="page-header__meta">
    <h1 class="page-header__title">스펙 찾기</h1>
    <div class="page-header__summary sd-summary">공공데이터 원본과 기관 공지 자동 검증을 통과한 일정만 보여 드립니다. 등록하면 접수·시험 일정과 할 일이 자동으로 추가됩니다.</div>
  </div>
  <div class="page-header__actions">
    <a href="/specs" class="btn">스펙 관리</a>
  </div>
</div>

<section class="card sd-sources" aria-label="데이터 소스 상태">
  <ul class="sd-sources__list">
    <% for (const s of statuses) { %>
      <li class="sd-sources__item <%= s.enabled ? 'sd-sources__item--on' : 'sd-sources__item--off' %>">
        <span class="sd-sources__dot" aria-hidden="true"></span>
        <span class="sd-sources__name"><%= s.label %></span>
        <span class="sd-sources__state"><%= s.enabled ? '사용 가능' : s.reason %></span>
      </li>
    <% } %>
  </ul>
</section>

<section class="card" data-sd-root>
  <form action="/specs/discover" method="POST" class="ai-discover-form sd-form" data-sd-form>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button type="submit" name="mode" value="search" class="sr-only" tabindex="-1" aria-hidden="true">검색</button>

    <fieldset class="ai-step">
      <legend class="ai-step__legend">
        <span class="ai-step__num num">1</span>
        <span class="ai-step__title">어떤 스펙을 찾나요?</span>
        <span class="ai-step__hint">1개 선택</span>
      </legend>
      <div class="ai-chip-row" role="radiogroup" aria-label="스펙 종류">
        <% for (const k of opts.KINDS) { %>
          <label class="ai-chip">
            <input type="radio" name="kind" value="<%= k.value %>" class="ai-chip__input" data-sd-kind <%= f.kind === k.value ? 'checked' : '' %>>
            <span class="ai-chip__label"><%= k.label %></span>
          </label>
        <% } %>
      </div>
    </fieldset>

    <fieldset class="ai-step">
      <legend class="ai-step__legend">
        <span class="ai-step__num num">2</span>
        <span class="ai-step__title">세부 조건</span>
      </legend>

      <div class="sd-panel" data-sd-panel="certificate">
        <div class="ai-field-group__heading sd-panel__heading">자격증</div>
        <div class="sd-catalog">
          <label class="sd-label" for="sd-cert-query">자격증 검색</label>
          <div class="sd-catalog__row">
            <input id="sd-cert-query" name="cert_query" class="input" maxlength="40" placeholder="예: 정보처리, 전기, 빅데이터" value="<%= f.cert_query || '' %>" autocomplete="off" data-sd-cert-query>
            <button type="submit" name="mode" value="catalog" class="btn" data-sd-catalog-btn>목록 검색</button>
          </div>
          <label class="sd-label" for="sd-cert-code">자격증 선택</label>
          <select id="sd-cert-code" name="cert_code" class="input" data-sd-cert-select>
            <% for (const c of catalog) { %>
              <option value="<%= c.jmCd %>" <%= f.cert_code === c.jmCd ? 'selected' : '' %>><%= c.name %> · <%= c.field %></option>
            <% } %>
          </select>
          <span class="sd-hint" data-sd-catalog-status aria-live="polite"><%= catalog.length ? '' : '검색 결과가 없습니다. 다른 이름으로 검색해 보세요.' %></span>
        </div>
        <div class="sd-sub">
          <span class="sd-label">시행 연도</span>
          <div class="ai-chip-row" role="radiogroup" aria-label="시행 연도">
            <% for (const y of opts.YEARS) { %>
              <label class="ai-chip"><input type="radio" name="year" value="<%= y %>" class="ai-chip__input" <%= f.year === y ? 'checked' : '' %>><span class="ai-chip__label num"><%= y %>년</span></label>
            <% } %>
          </div>
        </div>
      </div>

      <div class="sd-panel" data-sd-panel="bootcamp">
        <div class="ai-field-group__heading sd-panel__heading">부트캠프·교육</div>
        <% const groups = [
          ['분야', 'ncs', opts.BOOTCAMP_FIELDS],
          ['지역', 'region', opts.REGIONS],
          ['시작 기간', 'months', opts.PERIODS.map((p) => ({ value: p, label: p + '개월 이내' }))],
          ['과정 유형', 'track', [{ value: 'C0104', label: 'K-디지털 트레이닝' }, { value: 'C0105', label: 'K-디지털 기초역량' }, { value: 'C0061', label: '국민내일배움카드' }]],
        ]; %>
        <% for (const [heading, name, values] of groups) { %>
          <div class="sd-sub">
            <span class="sd-label"><%= heading %></span>
            <div class="ai-chip-row" role="radiogroup" aria-label="<%= heading %>">
              <% for (const v of values) { %>
                <label class="ai-chip"><input type="radio" name="<%= name %>" value="<%= v.value %>" class="ai-chip__input" <%= f[name] === v.value ? 'checked' : '' %>><span class="ai-chip__label"><%= v.label %></span></label>
              <% } %>
            </div>
          </div>
        <% } %>
      </div>

      <div class="sd-panel" data-sd-panel="contest activity">
        <div class="ai-field-group__heading sd-panel__heading">공모전·대외활동 분야 (최대 <%= opts.MAX_FIELDS_COUNT %>개)</div>
        <div class="ai-chip-row" aria-label="분야">
          <% for (const field of opts.ACTIVITY_FIELDS) { %>
            <label class="ai-chip"><input type="checkbox" name="activity_fields" value="<%= field %>" class="ai-chip__input" data-sd-field <%= ['contest', 'activity'].includes(f.kind) && selectedFields.includes(field) ? 'checked' : '' %>><span class="ai-chip__label"><%= field %></span></label>
          <% } %>
        </div>
      </div>

      <div class="sd-panel" data-sd-panel="grad_school">
        <div class="ai-field-group__heading sd-panel__heading">대학원 전공 (최대 <%= opts.MAX_FIELDS_COUNT %>개)</div>
        <div class="ai-chip-row" aria-label="전공">
          <% for (const field of opts.GRAD_FIELDS) { %>
            <label class="ai-chip"><input type="checkbox" name="grad_fields" value="<%= field %>" class="ai-chip__input" data-sd-field <%= f.kind === 'grad_school' && selectedFields.includes(field) ? 'checked' : '' %>><span class="ai-chip__label"><%= field %></span></label>
          <% } %>
        </div>
        <div class="sd-sub">
          <span class="sd-label">학위</span>
          <div class="ai-chip-row" role="radiogroup" aria-label="학위">
            <label class="ai-chip"><input type="radio" name="degree" value="" class="ai-chip__input" <%= !f.degree ? 'checked' : '' %>><span class="ai-chip__label">전체</span></label>
            <% for (const d of opts.DEGREES) { %>
              <label class="ai-chip"><input type="radio" name="degree" value="<%= d %>" class="ai-chip__input" <%= f.degree === d ? 'checked' : '' %>><span class="ai-chip__label"><%= d %></span></label>
            <% } %>
          </div>
        </div>
      </div>

      <div class="sd-panel" data-sd-panel="private_certificate">
        <div class="ai-field-group__heading sd-panel__heading">민간자격</div>
        <div class="ai-chip-row" role="radiogroup" aria-label="민간자격">
          <% for (const c of opts.PRIVATE_CERTS) { %>
            <label class="ai-chip"><input type="radio" name="private_cert" value="<%= c %>" class="ai-chip__input" <%= f.private_cert === c ? 'checked' : '' %>><span class="ai-chip__label"><%= c %></span></label>
          <% } %>
        </div>
      </div>

      <div class="sd-panel" data-sd-panel="public_job">
        <div class="ai-field-group__heading sd-panel__heading">공공기관 채용</div>
        <p class="sd-hint">잡알리오에 공시된 진행 중 공고를 찾습니다. 기관명이나 직무를 키워드로 입력하세요.</p>
      </div>

      <div class="ai-keyword-row sd-keyword">
        <label for="sd-keyword" class="ai-keyword-row__label">추가 키워드 (선택)</label>
        <input id="sd-keyword" name="keyword" class="input ai-keyword-row__input" maxlength="<%= opts.MAX_KEYWORD_LENGTH %>" placeholder="예: 데이터, 서울, 장학" value="<%= f.keyword %>">
      </div>
    </fieldset>

    <div class="inline-actions">
      <button type="submit" name="mode" value="search" class="btn btn-primary" data-sd-submit>스펙 찾기</button>
      <span class="text-muted text-sm" data-sd-status aria-live="polite"></span>
    </div>
  </form>

  <div class="ai-alert ai-alert--error <%= error ? '' : 'sd-hidden' %>" role="alert" data-sd-error><%= error || '' %></div>
</section>

<section class="card <%= list ? '' : 'sd-hidden' %>" data-sd-results>
  <div class="card__header">
    <div class="inline-actions">
      <h2 class="card__title">검색 결과</h2>
      <span class="badge num" data-sd-count><%= list ? list.length : 0 %></span>
    </div>
  </div>
  <ul class="sd-notices <%= notices.length ? '' : 'sd-hidden' %>" data-sd-notices>
    <% for (const n of notices) { %><li><strong><%= n.label %></strong> <%= n.message %></li><% } %>
  </ul>
  <p class="sd-hint <%= dropped ? '' : 'sd-hidden' %>" data-sd-dropped>자동 검증을 통과하지 못한 후보 <span class="num" data-sd-dropped-count><%= dropped %></span>건은 제외했습니다.</p>
  <p class="text-muted text-sm <%= list && list.length === 0 ? '' : 'sd-hidden' %>" data-sd-empty>조건에 맞는 일정을 찾지 못했습니다. 연도나 분야를 바꿔 다시 찾아보세요.</p>
  <ul class="sd-list" data-sd-list>
    <% if (list) { for (const item of list) { %>
      <%- include('../partials/specs/discover-card', { item }) %>
    <% } } %>
  </ul>
</section>

<template data-sd-template>
  <%- include('../partials/specs/discover-card', { item: null }) %>
</template>
<script src="/js/spec-discover.js" defer></script>
