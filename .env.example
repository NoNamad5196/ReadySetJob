PORT=3000
SESSION_SECRET=change-this-session-secret-in-production
DB_PATH=data/readysetjob.db

# OpenAI Responses API 설정 (미설정 시 AI 기능은 안전하게 비활성화됩니다)
OPENAI_API_KEY=

# 전체 AI 기능 공통 모델 오버라이드 (선택, 비워두면 기능별 기본값 사용)
OPENAI_MODEL=

# 기능별 OpenAI 모델 개별 설정 (선택)
# 면접 예상 질문 생성 (기본값: gpt-6.1-terra, reasoning effort: low)
OPENAI_MODEL_INTERVIEW=
# 자기소개서 문항 피드백 (기본값: gpt-6.1-terra, reasoning effort: medium)
OPENAI_MODEL_FEEDBACK=
# 경험 자료 STAR 초안 생성 (기본값: gpt-6.1-terra, reasoning effort: low)
OPENAI_MODEL_DRAFT=
# 채용 공고 텍스트 추출 (기본값: gpt-6-luna, reasoning effort: none)
OPENAI_MODEL_EXTRACT=

# 공공데이터포털 (data.go.kr) 오픈API 일반 인증키 (Q-Net 자격증 일정, DataQ, ALIO 공공기관 채용정보)
# Decoding 키 입력 권장 (URLSearchParams 이중 인코딩 방지). 미설정 시 안전 비활성화 배너 제공.
DATA_GO_KR_SERVICE_KEY=

# 고용24 (work24.go.kr) 오픈API 인증키 (K-Digital Training 부트캠프/훈련과정)
# 미설정 시에도 자격증/공공기관 조회 등 타 어댑터는 정상 작동합니다.
WORK24_AUTH_KEY=

